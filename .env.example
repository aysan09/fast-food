PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=ember_kitchen

# Use a Chapa test key first. Never put provider secrets in frontend code.
CHAPA_SECRET_KEY=
# Configure the same random value in Chapa Dashboard > Profile Settings > Webhooks.
CHAPA_WEBHOOK_SECRET=

# Customer-facing destinations for manual transfers.
BANK_ACCOUNT_NAME=
TELEBIRR_ACCOUNT=
CBE_ACCOUNT=

ADMIN_NAME=Restaurant Admin
ADMIN_EMAIL=admin@ember.et
ADMIN_PASSWORD=1234
CASHIER_NAME=Restaurant Cashier
CASHIER_EMAIL=cashier@ember.et
CASHIER_PASSWORD=1234
WAITER_NAME=Restaurant Waiter
WAITER_EMAIL=waiter@ember.et
WAITER_PASSWORD=1234